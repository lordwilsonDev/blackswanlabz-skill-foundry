    "steps": [
      {
        "line": 13,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "# AIL Operational Execution: Axiom Inversion Logic v0.1.0"
      },
      {
        "line": 15,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "## Abstract"
      },
      {
        "line": 19,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "## README"
      },
      {
        "line": 33,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "## SPEC"
      },
      {
        "line": 35,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "### Stage 1 \u2014 Identify"
      },
      {
        "line": 36,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Input: raw claim"
      },
      {
        "line": 37,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Output: `mission.json` (claim, domain tags, mode, operator count)"
      },
      {
        "line": 38,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Gate: delta threshold 0.4"
      },
      {
        "line": 40,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "### Stage 2 \u2014 Invert"
      },
      {
        "line": 41,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Invert each axiom via adversarial crew (Builder/Destroyer/Skeptic/Alternative Architect/Verifier/Unknown Hunter)"
      },
      {
        "line": 42,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Output: inverted claim set"
      },
      {
        "line": 44,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "### Stage 3 \u2014 Re-Derive"
      },
      {
        "line": 45,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Re-derive original claim from inverted claim set"
      },
      {
        "line": 46,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Output: reconstructed claim + delta score"
      },
      {
        "line": 48,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "### Stage 4 \u2014 Compare"
      },
      {
        "line": 49,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- delta = 1.0 - similarity(original, reconstructed)"
      },
      {
        "line": 50,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- delta >= 0.7 \u2192 HIGH falsifiability"
      },
      {
        "line": 51,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- 0.4 <= delta < 0.7 \u2192 MEDIUM falsifiability"
      },
      {
        "line": 52,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- delta < 0.4 \u2192 LOW falsifiability, RECYCLE"
      },
      {
        "line": 54,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "### Stage 5 \u2014 Synthesize"
      },
      {
        "line": 55,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Emit final verdict: SUPPORTED / REFUTED / INCONCLUSIVE"
      },
      {
        "line": 56,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Append to `ail_runs.db` with SHA-256 dedup key"
      },
      {
        "line": 58,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "### MoIE Routing"
      },
      {
        "line": 59,
        "source": "9785a0dba78b2d32d8c5812552e3b9d6d1e6cc75c160818fbfcd7d533a5185bf",
        "text": "- Mode A: <60s, single operator"
      },
      {
        "line": 13,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "# Inversion Challenge: AIL Adversarial Crew + Inversion Execution v0.1.0"
      },
      {
        "line": 15,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "## Abstract"
      },
      {
        "line": 19,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "## README"
      },
      {
        "line": 33,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "## SPEC"
      },
      {
        "line": 35,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "### Six-Role Adversarial Crew"
      },
      {
        "line": 46,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "### Inversion Process"
      },
      {
        "line": 47,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "1. Builder writes canonical claim"
      },
      {
        "line": 48,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "2. Destroyer inverts each premise"
      },
      {
        "line": 49,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "3. Skeptic flags untested assumptions"
      },
      {
        "line": 50,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "4. Alternative Architect proposes inversions"
      },
      {
        "line": 51,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "5. Verifier checks logical consistency"
      },
      {
        "line": 52,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "6. Unknown Hunter lists hidden premises"
      },
      {
        "line": 54,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "### Output Schema"
      },
      {
        "line": 73,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "### Escalation Rules"
      },
      {
        "line": 74,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- consistency_score < 0.5 \u2192 RECYCLE Stage 2"
      },
      {
        "line": 75,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- unknowns count > 5 \u2192 add operators within complexity budget"
      },
      {
        "line": 76,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- Mode A: Builder + Destroyer only (2 roles)"
      },
      {
        "line": 77,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- Mode B: all six roles"
      },
      {
        "line": 81,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "## RATIONALE"
      },
      {
        "line": 87,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "## RESEARCH"
      },
      {
        "line": 90,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- No crew definition \u2192 6-role rule-based crew"
      },
      {
        "line": 91,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- No inversion procedure \u2192 staged inversion protocol"
      },
      {
        "line": 92,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- No consistency check \u2192 Verifier role + consistency score"
      },
      {
        "line": 93,
        "source": "a67bac101e79e1a6abf636a25e3db900d8176a3822dfd0a09a762e803e0c0cfa",
        "text": "- No hidden-assumption detection \u2192 Unknown Hunter role"
      }
